{
  "name": "testdisk-photorec-web",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 3000",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0 --port 3000",
    "lint": "tsc --noEmit && eslint .",
    "setup:engines": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/setup-win-engines.ps1",
    "dist:win": "vite build --mode electron && electron-builder --win --x64"
  },
  "build": {
    "appId": "com.datarecovery.explorer",
    "productName": "Disk-Partition-Recovery-Explorer",
    "files": [
      "dist/**/*",
      "electron/**/*",
      "!electron/bin/**"
    ],
    "extraResources": [
      {
        "from": "electron/bin",
        "to": "engines"
      }
    ],
    "win": {
      "requestedExecutionLevel": "requireAdministrator",
      "target": [
        {
          "target": "zip",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "portable": {
      "requestExecutionLevel": "requireAdministrator"
    },
    "directories": {
      "output": "release"
    }
  },
  "dependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "eslint": "^10.15.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.8",
    "globals": "^17.14.0",
    "lucide-react": "^1.76.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwindcss": "^4.3.5",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.73.0",
    "vite": "^8.3.8"
  },
  "devDependencies": {
    "vite-plugin-pwa": "^2.0.0"
  }
}
